---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Coordination Compounds - Visual Learning" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap" rel="stylesheet">
		
		<!-- KaTeX -->
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
		<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.js"></script>
		<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/contrib/auto-render.min.js"
			onload="renderMathInElement(document.body, {delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}, {left: '\\(', right: '\\)', display: false}, {left: '\\[', right: '\\]', display: true}], throwOnError: false});"></script>
	</head>
	<body>
		<header>
			<h1><a href="/coordination-compounds/">coordination compounds</a></h1>
			<nav>
				<a href="/coordination-compounds/">concepts</a>
				<a href="/coordination-compounds/cheatsheet">cheat sheet</a>
			</nav>
		</header>
		<main>
			<slot />
		</main>
	</body>
</html>
<style is:global>
	*, *::before, *::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}
	:root {
		--bg: #000;
		--text: #e0e0e0;
		--border: #222;
		--accent: #888;
	}
	html, body {
		width: 100%;
		height: 100%;
		font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
		background: var(--bg);
		color: var(--text);
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}
	body {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}
	header {
		padding: 1.5rem 2rem;
		border-bottom: 1px solid var(--border);
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 1rem;
	}
	header h1 {
		font-size: 1.1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
	}
	header a {
		color: var(--text);
		text-decoration: none;
	}
	nav {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		color: var(--accent);
		text-transform: lowercase;
		font-size: 0.95rem;
		text-decoration: none;
		transition: color 0.2s;
	}
	nav a:hover {
		color: var(--text);
	}
	main {
		flex: 1;
		padding: 3rem 2rem;
		max-width: 900px;
		margin: 0 auto;
		width: 100%;
	}
	h1, h2, h3, h4 {
		font-weight: 500;
		text-transform: lowercase;
		letter-spacing: -0.02em;
	}
	h2 {
		font-size: 2rem;
		margin-bottom: 0.5rem;
	}
	h3 {
		font-size: 1.4rem;
		margin-bottom: 0.5rem;
		color: #fff;
	}
	p {
		line-height: 1.6;
		color: #bbb;
		margin-bottom: 1rem;
	}
	.concept-card {
		border: 1px solid var(--border);
		padding: 2rem;
		margin-bottom: 3rem;
		border-radius: 8px;
		background: #050505;
	}
	.visual-container {
		margin: 2rem 0;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: #0a0a0a;
		min-height: 300px;
		position: relative;
		overflow: hidden;
	}
	button {
		background: transparent;
		color: var(--text);
		border: 1px solid var(--border);
		padding: 0.5rem 1rem;
		border-radius: 4px;
		cursor: pointer;
		font-family: inherit;
		font-size: 0.9rem;
		transition: all 0.2s;
	}
	button:hover {
		border-color: var(--accent);
		color: #fff;
	}
	.question-block {
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px dashed var(--border);
	}
	.solution {
		display: none;
		margin-top: 1rem;
		padding: 1rem;
		background: #0a0a0a;
		border-left: 2px solid var(--border);
		font-size: 0.95rem;
	}
	
	/* KaTeX overrides */
	.katex { color: #e0e0e0 !important; font-size: 1.05em; }
	.katex-display { overflow-x: auto; overflow-y: hidden; padding: 0.5rem 0; }
	
	@media (max-width: 600px) {
		header { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
		main { padding: 2rem 1.5rem; }
		.concept-card { padding: 1.5rem; }
	}
</style>
