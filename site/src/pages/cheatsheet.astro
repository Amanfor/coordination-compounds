---
import Layout from '../layouts/Layout.astro';
import cheatsheet from '../data/cheatsheet.json';
---

<Layout title="Cheat Sheet | Coordination Compounds">
	
	<div class="hero">
		<h2 class="animate-title">cheat sheet</h2>
		<p class="subtitle animate-subtitle">Quick reference guide.</p>
	</div>

	
	<section class="concept-card">
		<h3>nomenclature rules</h3>
		<ol class="rules-list">
			{cheatsheet.nomenclature_rules.map((rule: string) => (
				<li>{rule}</li>
			))}
		</ol>
	</section>

	<section class="concept-card">
		<h3>spectrochemical series</h3>
		<p class="series-box">
			{cheatsheet.spectrochemical_series.join(' < ')}
		</p>
	</section>

	<section class="concept-card">
		<h3>hybridisation & geometry</h3>
		<div class="table-wrapper">
			<table>
				<thead>
					<tr>
						<th>CN</th>
						<th>Geometry</th>
						<th>Hybridisation</th>
						<th>Example</th>
					</tr>
				</thead>
				<tbody>
					{cheatsheet.hybridisation_table.map((row: any) => (
						<tr>
							<td>{row.cn}</td>
							<td>{row.geometry}</td>
							<td><code>{row.hybridisation}</code></td>
							<td><span set:html={row.example} /></td>
						</tr>
					))}
				</tbody>
			</table>
		</div>
	</section>

	<section class="concept-card">
		<h3>isomer types</h3>
		<div class="isomer-list">
			{cheatsheet.isomer_types.map((isomer: any) => (
				<div class="isomer-item">
					<div class="iso-header">
						<span class="iso-type">{isomer.type}</span> / <span class="iso-sub">{isomer.subtype}</span>
					</div>
					<p class="iso-desc">{isomer.description}</p>
					<div class="iso-ex">
						<span class="ex-label">Example:</span> <span set:html={isomer.example} />
					</div>
				</div>
			))}
		</div>
	</section>
</Layout>

<style>

	/* Text Entry Animations */
	.animate-title {
		opacity: 0;
		transform: translateY(20px);
		animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		font-size: 2.8rem;
		color: #fff;
	}
	.animate-subtitle {
		opacity: 0;
		transform: translateY(20px);
		animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
		font-size: 1.1rem;
		margin-top: 1rem;
	}
	
	@keyframes fadeUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	/* Card Enhancements */
	.concept-card {
		border: 1px solid var(--border);
		padding: 2rem;
		margin-bottom: 3rem;
		border-radius: 8px;
		background: #050505;
		transition: transform 0.3s ease, border-color 0.3s ease;
	}
	.concept-card:hover {
		transform: translateY(-4px);
		border-color: #555;
	}

	.hero { margin-bottom: 3rem; }
	.subtitle { color: var(--accent); }
	
	.rules-list {
		padding-left: 1.5rem;
		color: #ddd;
	}
	.rules-list li {
		margin-bottom: 0.5rem;
	}
	
	.series-box {
		font-family: monospace;
		background: #0a0a0a;
		border: 1px solid var(--border);
		padding: 1.5rem;
		border-radius: 4px;
		color: #fff;
		overflow-x: auto;
		white-space: nowrap;
	}
	
	.table-wrapper { overflow-x: auto; }
	table {
		width: 100%;
		border-collapse: collapse;
		min-width: 500px;
	}
	th {
		text-align: left;
		padding: 0.75rem;
		color: var(--accent);
		border-bottom: 1px solid var(--border);
		font-weight: 400;
	}
	td {
		padding: 0.75rem;
		border-bottom: 1px solid #111;
		color: #ddd;
	}
	code {
		color: #fff;
		background: #111;
		padding: 0.1rem 0.3rem;
		border-radius: 3px;
	}
	
	.isomer-list {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.isomer-item {
		padding-bottom: 1.5rem;
		border-bottom: 1px solid #111;
	}
	.isomer-item:last-child {
		border-bottom: none;
		padding-bottom: 0;
	}
	.iso-header {
		margin-bottom: 0.5rem;
	}
	.iso-type { color: var(--accent); }
	.iso-sub { color: #fff; font-weight: 500; }
	.iso-desc { color: #ccc; margin-bottom: 0.5rem; }
	.ex-label { color: var(--accent); font-size: 0.85rem; }
</style>
