---
import Layout from '../layouts/Layout.astro';
import conceptsData from '../data/concepts.json';
import questionsData from '../data/questions.json';

import CFTDiagram from '../components/visuals/CFTDiagram.astro';
import ColourWheel from '../components/visuals/ColourWheel.astro';
import GeometryViewer from '../components/visuals/GeometryViewer.astro';
import IsomerismViewer from '../components/visuals/IsomerismViewer.astro';
import NamingBuilder from '../components/visuals/NamingBuilder.astro';
import WernerExperiment from '../components/visuals/WernerExperiment.astro';
import EANCalculator from '../components/visuals/EANCalculator.astro';

const getVisualComponent = (visualName: string) => {
	switch(visualName) {
		case 'werner-experiment': return WernerExperiment;
		case 'naming-builder': return NamingBuilder;
		case 'geometry-viewer': return GeometryViewer;
		case 'isomerism-viewer': return IsomerismViewer;
		case 'ean-calculator': return EANCalculator;
		case 'cft-diagram': return CFTDiagram;
		case 'colour-wheel': return ColourWheel;
		default: return null;
	}
};
---

<Layout title="Coordination Compounds">
	
	<div class="hero">
		<div class="hero-visual">
			<div class="orbit orbit-1"></div>
			<div class="orbit orbit-2"></div>
			<div class="orbit orbit-3"></div>
			<div class="core">M</div>
		</div>
		<div class="hero-content">
			<h2 class="animate-title">coordination<br>chemistry</h2>
			<p class="subtitle animate-subtitle">A visual, minimal guide for JEE.</p>
		</div>
	</div>

	
	<div class="concept-list">
		{conceptsData.sort((a, b) => a.order - b.order).map(concept => {
			const Visual = getVisualComponent(concept.visual || '');
			const conceptQuestions = questionsData.filter((q: any) => q.concept === concept.id);
			
			return (
				<section class="concept-card" id={concept.id}>
					<h3>{concept.title}</h3>
					<p class="summary">{concept.summary}</p>
					<hr class="divider"/>
					
					{Visual && (
						<div class="visual-container">
							<Visual />
						</div>
					)}
					
					<div class="concept-body" set:html={concept.body.replace(/\n/g, '<br/>')} />
					
					{conceptQuestions.length > 0 && (
						<div class="questions-section">
							<h4>practice questions</h4>
							{conceptQuestions.map((q: any, i: number) => (
								<div class="question-block">
									<div class="q-header">
										<span class="q-number">Q{i+1}.</span>
										{q.source && <span class="q-source">{q.source}</span>}
									</div>
									<div class="q-text" set:html={q.question.replace(/\n/g, '<br/>')} />
									{q.options && q.options.length > 0 && (
										<ul class="options-list">
											{q.options.map((opt: string, j: number) => (
												<li><span class="opt-label">{String.fromCharCode(65+j)}.</span> <span set:html={opt} /></li>
											))}
										</ul>
									)}
									<button onclick={`const el = document.getElementById('sol-${q.id}'); if(el.style.display === 'block'){ el.style.display = 'none'; this.innerText='View Solution'; } else { el.style.display = 'block'; this.innerText='Hide Solution'; }`}>
										View Solution
									</button>
									<div id={`sol-${q.id}`} class="solution">
										<div class="ans-label">Answer: {q.answer}</div>
										<div class="sol-text" set:html={q.solution.replace(/\n/g, '<br/>')} />
									</div>
								</div>
							))}
						</div>
					)}
				</section>
			);
		})}
	</div>
</Layout>

<style>

	/* Hero Animations */
	.hero {
		display: flex;
		align-items: center;
		gap: 3rem;
		margin-bottom: 5rem;
		padding: 3rem 0;
		border-bottom: 1px solid var(--border);
	}
	.hero-content {
		flex: 1;
	}
	.hero-visual {
		position: relative;
		width: 150px;
		height: 150px;
		display: flex;
		justify-content: center;
		align-items: center;
		flex-shrink: 0;
	}
	
	@media (max-width: 600px) {
		.hero {
			flex-direction: column-reverse;
			text-align: center;
			gap: 2rem;
			padding: 2rem 0;
		}
	}

	/* CSS Atom/Orbital Animation */
	.core {
		position: absolute;
		width: 30px;
		height: 30px;
		background: #fff;
		color: #000;
		border-radius: 50%;
		display: flex;
		justify-content: center;
		align-items: center;
		font-weight: bold;
		font-size: 14px;
		z-index: 10;
		box-shadow: 0 0 15px rgba(255,255,255,0.5);
	}
	.orbit {
		position: absolute;
		width: 100%;
		height: 100%;
		border: 1px dashed rgba(255, 255, 255, 0.3);
		border-radius: 50%;
	}
	.orbit-1 { animation: spin 8s linear infinite; }
	.orbit-2 { animation: spin 12s linear infinite reverse; transform: rotateX(60deg) rotateY(45deg); }
	.orbit-3 { animation: spin 10s linear infinite; transform: rotateX(45deg) rotateY(60deg); }
	
	.orbit::before {
		content: '';
		position: absolute;
		top: -4px;
		left: 50%;
		width: 8px;
		height: 8px;
		background: #fff;
		border-radius: 50%;
		box-shadow: 0 0 10px #fff;
	}

	@keyframes spin {
		0% { transform: rotate(0deg) scaleY(0.4); }
		100% { transform: rotate(360deg) scaleY(0.4); }
	}
	
	/* Text Entry Animations */
	.animate-title {
		opacity: 0;
		transform: translateY(20px);
		animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
		font-size: 2.8rem;
		line-height: 1.1;
		color: #fff;
	}
	.animate-subtitle {
		opacity: 0;
		transform: translateY(20px);
		animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s forwards;
		font-size: 1.1rem;
		margin-top: 1rem;
	}
	
	@keyframes fadeUp {
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	
	
	/* Staggered Card Entry */
	.concept-card {
		opacity: 0;
		animation: fadeUpCard 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
	}
	.concept-card:nth-child(1) { animation-delay: 0.2s; }
	.concept-card:nth-child(2) { animation-delay: 0.3s; }
	.concept-card:nth-child(3) { animation-delay: 0.4s; }
	.concept-card:nth-child(4) { animation-delay: 0.5s; }
	.concept-card:nth-child(n+5) { animation-delay: 0.6s; }

	@keyframes fadeUpCard {
		0% { opacity: 0; transform: translateY(30px); }
		100% { opacity: 1; transform: translateY(0); }
	}

	/* Floating Visuals */
	.visual-container {
		animation: float 6s ease-in-out infinite;
	}
	@keyframes float {
		0% { transform: translateY(0px); }
		50% { transform: translateY(-8px); }
		100% { transform: translateY(0px); }
	}
	
	/* Button hover pulse */
	button:hover {
		animation: pulse 1s infinite;
	}
	@keyframes pulse {
		0% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.4); }
		70% { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
		100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
	}

	/* Card Enhancements */
	.concept-card {
		transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
	}
	.concept-card:hover {
		transform: translateY(-4px);
		border-color: #555;
		box-shadow: 0 10px 30px rgba(255,255,255,0.02);
	}

	.hero {
		margin-bottom: 3rem;
	}
	.subtitle {
		color: var(--accent);
	}
	.summary {
		color: var(--accent);
		font-style: italic;
		margin-bottom: 1.5rem;
	}
	.concept-body {
		line-height: 1.6;
		color: #ccc;
	}
	
	.questions-section {
		margin-top: 3rem;
		padding-top: 2rem;
		border-top: 1px solid var(--border);
	}
	.q-header {
		display: flex;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}
	.q-number {
		font-weight: 600;
		color: #fff;
	}
	.q-source {
		font-size: 0.75rem;
		color: var(--accent);
		border: 1px solid #333;
		padding: 0.1rem 0.4rem;
		border-radius: 3px;
	}
	.q-text {
		margin-bottom: 1rem;
		color: #ddd;
	}
	.options-list {
		list-style: none;
		margin-bottom: 1.5rem;
	}
	.options-list li {
		margin-bottom: 0.5rem;
		display: flex;
		gap: 0.5rem;
	}
	.opt-label {
		color: var(--accent);
	}
	.ans-label {
		font-weight: 500;
		margin-bottom: 0.5rem;
		color: #fff;
	}
</style>

